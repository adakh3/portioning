# Copy to backend/.env and fill in. Everything except SECRET_KEY has a working
# default for local dev — unset integrations simply switch themselves off.

# ── Core (required) ──
SECRET_KEY=change-me-to-something-long-and-random
DEBUG=True
# Comma-separated. Must be set explicitly once DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1
# Omit for the local sqlite file; set to a postgres:// URL in production.
# DATABASE_URL=

# Where the Next.js app is served — used for redirects back into the app.
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Client email: send from the caterer's own mailbox (REL-460) ──
# Leave these blank in local dev and CI: with no OAuth app configured the
# backend uses a fake transport, so "Connect your email" and sending both work
# offline and captured messages land in bookings.services.email.outbox.
#
# Google: Cloud Console OAuth client (Web application), scope gmail.send only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft: Entra app registration, delegated Mail.Send + offline_access.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# Public origin the provider redirects back to. Must match the redirect URI
# registered with the provider exactly, which is:
#   <OAUTH_REDIRECT_BASE>/api/integrations/email/callback/
# Prod: https://catering.relogue.com
OAUTH_REDIRECT_BASE=http://localhost:8000
# Encrypts mailbox refresh tokens at rest. Optional (falls back to SECRET_KEY),
# but set it in production so rotating SECRET_KEY doesn't force every caterer to
# reconnect their mailbox. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When set it is used ALONE — SECRET_KEY stops being a key to the tokens. To
# change this key (or move off SECRET_KEY) without making every caterer
# reconnect, put the previous value in the comma-separated fallbacks below:
# they decrypt existing rows while every new write uses the key above.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_FALLBACKS=
# Capture client email instead of sending it. Defaults on under DEBUG and the
# test runner, off otherwise — leave it off in production, or a missing OAuth
# client id turns every quote and contract into a silent no-op.
EMAIL_FAKE_TRANSPORT=

# ── WhatsApp (platform-level Twilio account; each org sets its own number) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── AI ──
# Only the provider actually in use needs a key. See portioning/llm.py.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 'provider:model' per task — switching supplier is a one-var change.
# LLM_FOLLOWUP_DRAFTER=openai:gpt-5.4-nano

# ── Billing (Stripe) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
DEFAULT_TRIAL_DAYS=7

# ── Scheduled jobs ──
# Shared secret for the cron endpoint (GitHub Actions). Unset = endpoint disabled.
CRON_SECRET=
