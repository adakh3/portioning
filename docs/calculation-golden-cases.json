    {
      "name": "discount_larger_than_subtotal_never_makes_a_negative_service_charge",
      "_why": "A discount bigger than the booking used to flip the service charge and gratuity negative too (a -95,000 subtotal produced a -19,000 'service charge'), compounding the error. Percentage charges are now taken on max(subtotal, 0). The save path rejects a negative subtotal outright; this pins the engine so the live preview and any already-stored row stay sane.",
      "food_total": "5000",
      "items": [
        {
          "line_total": "-100000"
        }
      ],
      "tax_rate": "0",
      "service_charge_pct": "20",
      "service_charge_taxable": true,
      "gratuity_pct": "10",
      "expected": {
        "subtotal": "-95000.00",
        "service_charge": "0.00",
        "tax_base": "-95000.00",
        "tax_amount": "0.00",
        "gratuity": "0.00",
        "total": "-95000.00"
      }
    },
    {
      "name": "discount_to_exactly_zero_charges_nothing",
      "_why": "The boundary: a discount that exactly cancels the booking. Zero subtotal, zero charges, zero total.",
      "food_total": "5000",
      "items": [
        {
          "line_total": "-5000"
        }
      ],
      "tax_rate": "0.20",
      "service_charge_pct": "20",
      "service_charge_taxable": true,
      "gratuity_pct": "10",
      "expected": {
        "subtotal": "0.00",
        "service_charge": "0.00",
        "tax_base": "0.00",
        "tax_amount": "0.00",
        "gratuity": "0.00",
        "total": "0.00"
      }
    },
    {
      "name": "a_normal_discount_still_reduces_the_service_charge_base",
      "_why": "Guard from the other side: a legitimate discount must still shrink the charge base, not be ignored.",
      "food_total": "5000",
      "items": [
        {
          "line_total": "-1000"
        }
      ],
      "tax_rate": "0",
      "service_charge_pct": "20",
      "service_charge_taxable": true,
      "gratuity_pct": "0",
      "expected": {
        "subtotal": "4000.00",
        "service_charge": "800.00",
        "tax_base": "4800.00",
        "tax_amount": "0.00",
        "gratuity": "0.00",
        "total": "4800.00"
      }
    },
    {
      "name": "half_up_tax_on_a_005_boundary",
      "_why": "A .005 boundary \u2014 the one place Decimal's default HALF_EVEN and the frontend's Math.round (HALF_UP) disagree. The engines differed by a cent here: the live preview showed 5.01 and the saved value was 5.00, so the total moved under the user on save. Both engines must now round HALF_UP.",
      "food_total": "100.10",
      "items": [],
      "tax_rate": "0.05",
      "expected": {
        "subtotal": "100.10",
        "tax_amount": "5.01",
        "total": "105.11"
      }
    },
    {
      "name": "half_up_service_charge_on_a_005_boundary",
      "_why": "Same boundary via the service charge (5% of 100.10 = 5.005).",
      "food_total": "100.10",
      "items": [],
      "tax_rate": "0",
      "service_charge_pct": "5",
      "service_charge_taxable": true,
      "gratuity_pct": "0",
      "expected": {
        "subtotal": "100.10",
        "service_charge": "5.01",
        "tax_base": "105.11",
        "tax_amount": "0.00",
        "gratuity": "0.00",
        "total": "105.11"
      }
    },
    {
      "name": "half_up_gratuity_on_a_005_boundary",
      "_why": "Same boundary via the gratuity (5% of 100.10 = 5.005).",
      "food_total": "100.10",
      "items": [],
      "tax_rate": "0",
      "service_charge_pct": "0",
      "service_charge_taxable": true,
      "gratuity_pct": "5",
      "expected": {
        "subtotal": "100.10",
        "service_charge": "0.00",
        "tax_base": "100.10",
        "tax_amount": "0.00",
        "gratuity": "5.01",
        "total": "105.11"
      }
    },
    {
      "name": "half_up_tax_on_a_larger_005_boundary",
      "_why": "2.5% of 200.20 = 5.005 \u2014 proves it is the boundary, not the number.",
      "food_total": "200.20",
      "items": [],
      "tax_rate": "0.025",
      "expected": {
        "subtotal": "200.20",
        "tax_amount": "5.01",
        "total": "205.21"
      }
    },
    {
      "name": "fractional_us_rates_together",
      "_why": "A realistic US booking: 8.25% sales tax, 20% service charge, 18% gratuity, on an amount that does not divide cleanly.",
