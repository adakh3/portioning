    {
      "name": "food_only_with_tax",
      "food_total": "1000.00",
      "items": [],
      "tax_rate": "0.20",
      "expected": {
        "subtotal": "1000.00",
        "tax_amount": "200.00",
        "total": "1200.00"
      }
    },
    {
