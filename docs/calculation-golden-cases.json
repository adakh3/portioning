    {
      "name": "rel449_unusable_override_reverts_to_multiplier_negative",
      "_why": "A negative per-segment override must never pay the customer to attend. It is refused at the API; the engines IGNORE it and the segment reverts to its multiplier \u2014 falling back, never making the cover free. 90 adults @10 + 10 kids @5 (0.5x) = 950.00.",
      "price_per_head": "10",
      "segments": [
        {
          "count": 90,
          "price_multiplier": "1.0"
        },
        {
          "count": 10,
          "price_multiplier": "0.5",
          "price_override": "-1000"
        }
      ],
      "expected_food": "950.00"
    },
    {
      "name": "rel449_unusable_override_reverts_to_multiplier_junk",
      "_why": "A non-numeric override must not poison the sum with NaN. Ignored, so kids revert to 0.5x: 90 adults @10 + 10 kids @5 = 950.00.",
      "price_per_head": "10",
      "segments": [
        {
          "count": 90,
          "price_multiplier": "1.0"
        },
        {
          "count": 10,
          "price_multiplier": "0.5",
          "price_override": "abc"
        }
      ],
      "expected_food": "950.00"
    },
    {
      "name": "rel449_unusable_multiplier_reverts_to_full_price_junk",
      "_why": "A non-numeric multiplier is bad org config, not typing. It reverts to 1.0 \u2014 FULL price \u2014 because flooring to zero would turn a config error into a silent discount nobody would spot. 90 @10 + 10 @10 = 1000.00.",
      "price_per_head": "10",
      "segments": [
        {
          "count": 90,
          "price_multiplier": "1.0"
        },
        {
          "count": 10,
          "price_multiplier": "abc"
        }
      ],
      "expected_food": "1000.00"
    },
    {
      "name": "rel449_unusable_multiplier_reverts_to_full_price_negative",
      "_why": "A negative multiplier must not subtract from the food total, and must not make the segment free either. Reverts to 1.0: 90 @10 + 10 @10 = 1000.00.",
      "price_per_head": "10",
      "segments": [
        {
          "count": 90,
          "price_multiplier": "1.0"
        },
        {
          "count": 10,
          "price_multiplier": "-1.0"
        }
      ],
      "expected_food": "1000.00"
    }
